# Required API keys
USDA_API_KEY=your_usda_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database — SQLite for dev, PostgreSQL for production
DATABASE_URL=sqlite:///./nutrition_pal.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret — MUST be changed in production (use: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-in-production

# CORS origins — comma-separated list of allowed frontend URLs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "production" on Railway to enforce SECRET_KEY
ENVIRONMENT=development
